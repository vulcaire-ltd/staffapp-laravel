{
    "name": "vulcaire/staffapp-laravel",
    "description": "Laravel integration for the AssignPoint API.",
    "keywords": ["assignpoint", "laravel", "api", "sdk", "webhooks", "workforce"],
    "homepage": "https://assignpoint.com",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Vulcaire Ltd",
            "email": "hello@assignpoint.com",
            "homepage": "https://assignpoint.com"
        }
    ],
    "support": {
        "email": "hello@assignpoint.com",
        "issues": "https://github.com/vulcaire-ltd/staffapp-laravel/issues",
        "source": "https://github.com/vulcaire-ltd/staffapp-laravel"
    },
    "require": {
        "illuminate/bus": "^11.0 || ^12.0",
        "illuminate/console": "^11.0 || ^12.0",
        "illuminate/contracts": "^11.0 || ^12.0",
        "illuminate/http": "^11.0 || ^12.0",
        "illuminate/queue": "^11.0 || ^12.0",
        "illuminate/support": "^11.0 || ^12.0",
        "php": "^8.2",
        "vulcaire/staffapp-php": "^0.1"
    },
    "require-dev": {
        "orchestra/testbench": "^9.5 || ^10.0",
        "phpunit/phpunit": "^11.5 || ^12.5"
    },
    "autoload": {
        "psr-4": {
            "Vulcaire\\StaffApp\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vulcaire\\StaffApp\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vulcaire\\StaffApp\\Laravel\\StaffAppServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
