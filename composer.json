{
    "name": "vulcaire/staffapp-laravel",
    "description": "Laravel integration for the Vulcaire StaffApp PHP client.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "vulcaire/staffapp-php": "^0.1",
        "illuminate/bus": "^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/queue": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {"orchestra/testbench": "^9.5 || ^10.0 || ^11.0", "phpunit/phpunit": "^11.5 || ^12.5"},
    "autoload": {"psr-4": {"Vulcaire\\StaffApp\\Laravel\\": "src/"}},
    "autoload-dev": {"psr-4": {"Vulcaire\\StaffApp\\Laravel\\Tests\\": "tests/"}},
    "extra": {"laravel": {"providers": ["Vulcaire\\StaffApp\\Laravel\\StaffAppServiceProvider"]}},
    "scripts": {"test": "phpunit"}
}
